rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function createVerifyFields(required, optional) {
      let allowed = required.concat(optional);
      return request.resource.data.keys().hasAll(required) &&
        request.resource.data.keys().hasOnly(allowed);
    }

    function updateVerifyFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('a', false) == true;
    }

    function isSignedInUser(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    function hasProjectRole(roleClaims) {
      return isSignedIn() &&
        request.auth.token.get(['p', 'projects'], []).hasAny(roleClaims);
    }

    function isOwner(projectId) {
      return hasProjectRole([projectId + ':o']);
    }

    function isManager(projectId) {
      return hasProjectRole([projectId + ':o', projectId + ':m']);
    }

    function isWriter(projectId) {
      return hasProjectRole([projectId + ':o', projectId + ':m', projectId + ':w']);
    }

    function isReader(projectId) {
      return hasProjectRole([
        projectId + ':o',
        projectId + ':m',
        projectId + ':w',
        projectId + ':r'
      ]);
    }

    function sampleFieldsValidTypes(data) {
      return (data.name is string) &&
        (data.count is number);
    }

    function userFieldsValidTypes(data) {
      return (data.displayName is string) &&
        (data.get('email', '') is string) &&
        (data.get('image', '') is string) &&
        (data.get('lang', 'en') in ['en', 'ja']) &&
        (data.get('permissions', {}) is map) &&
        (data.get('admin', false) is bool);
    }

    function projectUserFieldsValid(data) {
      return createVerifyFields(['displayName', 'email', 'role'], ['image']) &&
        (data.displayName is string) &&
        (data.email is string) &&
        (data.get('image', '') is string) &&
        (data.role in ['owner', 'manager', 'writer', 'reader']);
    }

    function isNonOwnerProjectUser(data) {
      return data.role != 'owner';
    }

    function isDifferentSignedInUser(uid) {
      return isSignedIn() && request.auth.uid != uid;
    }

    function preservesOwnProjectRole(uid) {
      return isDifferentSignedInUser(uid) ||
        resource.data.role == request.resource.data.role;
    }

    function projectPermissions(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
        .get('permissions', {})
        .get('projects', []);
    }

    function canAddProjectMembership(uid, pid) {
      // Keep this limit in sync with MAX_PROJECTS_PER_USER in the project service.
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        (
          projectPermissions(uid).size() < 30 ||
          projectPermissions(uid).hasAny([
            pid + ':o',
            pid + ':m',
            pid + ':w',
            pid + ':r'
          ])
        );
    }

    match /users/{uid} {
      allow update: if
        updateVerifyFields(['displayName', 'email', 'image', 'lang', 'updatedAt']) &&
        userFieldsValidTypes(request.resource.data) &&
        isSignedInUser(uid);
      allow read: if
        isSignedInUser(uid);
    }

    match /projects/{pid} {
      allow read: if isWriter(pid);
      allow update: if isManager(pid);
      allow delete: if isOwner(pid);

      match /users/{uid} {
        allow read: if isReader(pid);
        allow create: if
          isDifferentSignedInUser(uid) &&
          canAddProjectMembership(uid, pid) &&
          projectUserFieldsValid(request.resource.data) &&
          (
            isOwner(pid) ||
            (isManager(pid) && isNonOwnerProjectUser(request.resource.data))
          );
        allow update: if
          preservesOwnProjectRole(uid) &&
          projectUserFieldsValid(request.resource.data) &&
          (
            isOwner(pid) ||
            (
              isManager(pid) &&
              isNonOwnerProjectUser(resource.data) &&
              isNonOwnerProjectUser(request.resource.data)
            )
          );
        allow delete: if
          isDifferentSignedInUser(uid) &&
          (
            isOwner(pid) ||
            (isManager(pid) && isNonOwnerProjectUser(resource.data))
          );
      }
    }

    // Public demo collection: the default site reads and writes it without
    // signing in, so access is open but constrained to the expected shape.
    match /samples/{id} {
      allow read: if true;
      allow create: if
        createVerifyFields(['name', 'count', 'createdAt', 'updatedAt'], []) &&
        sampleFieldsValidTypes(request.resource.data);
      allow update: if
        updateVerifyFields(['name', 'count', 'updatedAt']) &&
        sampleFieldsValidTypes(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
