{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "paths": {
      "@firestore/*": ["../firestore/src/*"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src", "../firestore/src", "*.config.ts"]
}
