{
  "$schema": "../node_modules/@lit/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["ja"],
  "tsConfig": "./tsconfig.json",
  "output": {
    "mode": "runtime",
    "outputDir": "./src/generated/locales",
    "localeCodesModule": "./src/generated/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./xliff"
  }
}
