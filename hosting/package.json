{
  "name": "hosting",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "postlocalize:build": "vp fmt -c ../.oxfmtrc.json src/generated",
    "prebuild": "npm run localize:build",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint . && npm run lint:lit",
    "lint:lit": "lit-analyzer \"src/**/*.ts\" --quiet",
    "fmt": "vp fmt -c ../.oxfmtrc.json",
    "check": "vp fmt --check -c ../.oxfmtrc.json && vp check --no-fmt",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:default": "APP_SITE=default npm run lint",
    "build:default": "APP_SITE=default npm run build",
    "lint:admin": "APP_SITE=admin npm run lint",
    "build:admin": "APP_SITE=admin npm run build"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/localize": "^0.12.2",
    "@mzsn/firestore": "^1.2.13",
    "firebase": "^12.18.0",
    "lit": "^3.3.3",
    "lit-async": "^0.3.3",
    "lit-share": "^0.1.3",
    "lucide": "^1.34.0",
    "tailwindcss": "^4.3.3",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "firebase-admin": "^14.3.0",
    "happy-dom": "^20.11.6",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": "24 || 26"
  }
}
