rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('a', false) == true;
    }

    function isSignedInUser(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    function hasProjectRole(roleClaims) {
      return isSignedIn() &&
        request.auth.token.get(['p', 'projects'], []).hasAny(roleClaims);
    }

    function isOwner(projectId) {
      return hasProjectRole([projectId + ':o']);
    }

    function isManager(projectId) {
      return hasProjectRole([projectId + ':o', projectId + ':m']);
    }

    function isWriter(projectId) {
      return hasProjectRole([projectId + ':o', projectId + ':m', projectId + ':w']);
    }

    function isReader(projectId) {
      return hasProjectRole([
        projectId + ':o',
        projectId + ':m',
        projectId + ':w',
        projectId + ':r'
      ]);
    }

    function isActive(meta) {
      return meta.active == 'true';
    }

    function isWithinDateRange(meta) {
      let now = request.time.toMillis() / 1000;
      let hasBeginDate = 'beginDate' in meta;
      let hasEndDate = 'endDate' in meta;
      let beginOk = !hasBeginDate || int(meta.beginDate) <= now;
      let endOk = !hasEndDate || now <= int(meta.endDate);
      return beginOk && endOk;
    }

    function hasAccess(meta) {
      return isActive(meta) && isWithinDateRange(meta);
    }

    function isRasterImageUpload() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches('image/(jpeg|png|gif|webp|avif)');
    }

    function isValidAvatarUpload() {
      return request.resource.size <= 5 * 1024 * 1024 &&
        isRasterImageUpload();
    }

    function isValidProjectUpload() {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType != null &&
        (
          isRasterImageUpload() ||
          request.resource.contentType.matches('(application/(pdf|json)|text/(plain|csv))(;.*)?')
        );
    }

    match /users/{uid}/avatar/{filename} {
      allow get: if true;
      allow list: if isSignedInUser(uid);
      allow create, update: if
        filename == 'profile' &&
        isSignedInUser(uid) &&
        isValidAvatarUpload();
      allow delete: if isSignedInUser(uid);
    }

    match /projects/{pid} {
      allow read: if isWriter(pid);
      allow update: if isManager(pid) && isValidProjectUpload();
      allow delete: if isOwner(pid);

      match /{allPaths=**} {
        allow read: if isReader(pid) && hasAccess(resource.metadata);
        allow create, update: if isManager(pid) && isValidProjectUpload();
        allow delete: if isManager(pid);
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
